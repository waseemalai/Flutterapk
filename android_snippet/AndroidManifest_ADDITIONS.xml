<!--
  Paste this <service> block inside the <application> tag of
  android/app/src/main/AndroidManifest.xml (the one generated by
  `flutter create`), right after the existing <activity> block.

  Also make sure the <manifest> tag's package matches:
  package="com.example.keyboard_app"
  (change it in every .kt file too if you use a different package name)
-->

<service
    android:name=".CustomKeyboardService"
    android:label="Professional Keyboard"
    android:permission="android.permission.BIND_INPUT_METHOD"
    android:exported="true">
    <intent-filter>
        <action android:name="android.view.InputMethod" />
    </intent-filter>
    <meta-data
        android:name="android.view.im"
        android:resource="@xml/method" />
</service>
